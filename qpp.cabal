  main-is: RootFindingTest.hs

executable SparseMatrixTest
  import: exercises-common
  build-depends:
    poly,
    vector
  main-is: SparseMatrixTest.hs

executable SunderhaufTest
  import: exercises-common
  build-depends:
    poly,
    vector
  main-is: SunderHaufTest.hs

executable Stabilizers
  import: exercises-common
  build-depends:
    bv
  main-is: Stabilizers.hs

-- ---------------------------------------------------------------------------
