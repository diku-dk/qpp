cabal-version:   3.4
name:            qpp
version:         0.1.0.0
synopsis:        HQP language playground in Haskell
license:         BSD-3-Clause
license-file:    LICENSE
author:          James Avery
maintainer:      avery@diku.dk
category:        Math
build-type:      Simple
extra-doc-files: CHANGELOG.md, latex/operator-diagrams.tex
data-files: latex/qpp-tikz.sty

common warnings
    ghc-options: -Wall -Wno-orphans


common common-options
    default-language: GHC2021    
    -- Everything GHC2021 already implies is left out (FlexibleContexts,
    -- FlexibleInstances, TypeSynonymInstances, BinaryLiterals,
    -- TypeApplications, ScopedTypeVariables, GeneralizedNewtypeDeriving).
    -- Narrower extensions live in per-file {-# LANGUAGE #-} pragmas.
    default-extensions:
        NoMonomorphismRestriction,
        TypeFamilies,
        PatternSynonyms,
        ViewPatterns,
        LambdaCase

library
    import:   warnings, common-options
    exposed-modules:
      QPP
      -- QOp syntax definitions and Operator typeclass:
      QPP.Syntax
      -- General finite-dimensional unitary syntax:
      QPP.UOp
      QPP.UOp.Syntax
      QPP.UOp.FromQOp
      QPP.UOp.Normalize
      -- Flat circuits: gates on explicit wires, bridged to QOp:
      QPP.QCirc
      QPP.QCirc.Syntax
      QPP.QCirc.FromQOp
      QPP.QCirc.Rewrite
      -- Symbolic well-formedness and rotation-axis checks:
      QPP.TypeCheck
      -- QOp program transformations for optimization and analysis:
      QPP.Rewrite
      QPP.Util
      -- HQP Semantics backend implementations:
      QPP.Semantics
      QPP.Semantics.Matrix
      QPP.Semantics.Statevector
      -- Exact cyclotomic arithmetic, unitary evaluation, measurement and reset:
      QPP.Exact.Types
      QPP.Exact.Scalar
      QPP.Exact.State
      QPP.Exact.Checked
      QPP.Semantics.Exact.Matrix
      QPP.Semantics.Exact.Statevector
      --QPP.Semantics.StateHmatrix
      QPP.MPS
      QPP.MPS.Diagonal
      QPP.Semantics.MPS
      QPP.Semantics.Stabilizer
      -- Pretty-printing HQP programs and representations:
      QPP.PrettyPrint
      QPP.PrettyPrint.Op
      QPP.PrettyPrint.UOp
      QPP.PrettyPrint.QCirc
      QPP.PrettyPrint.TikZ
      QPP.PrettyPrint.Matrix
      -- Example quantum programs written in HQP:
      Programs.QFT
      Programs.MatrixPreparation
      Programs.SparseMatrixPreparation
      Programs.MatrixArithmetic
      Programs.Qubitization
      Programs.SVT
      Programs.RootFinding
      Programs.SunderhaufOptPoly
      Programs.QuantumAdder
      Programs.RepeaterProtocol

    other-modules:
      QPP.TypeCheck.Pauli
      QPP.Exact.Internal.Scalar
      QPP.Exact.Internal.Order
      QPP.Exact.Internal.Measurement
      QPP.Exact.Internal.Buffer
      QPP.Exact.Internal.Evaluation
      QPP.Exact.Internal.State
      QPP.Exact.Internal.Gates
      QPP.Exact.Internal.Matrix
      QPP.Exact.Internal.Plan
      QPP.Exact.Internal.Vector

    build-depends:  
        base,
        hmatrix,
        mtl,
        array,
        containers,
        massiv,
        vector,
        integer-logarithms,
        ieee754,
        pqueue,
        poly,
        semirings
--        hasktorch
    hs-source-dirs:   src

common exercises-common
  default-language: GHC2021
  hs-source-dirs: exercises
  build-depends:
      base,
      hmatrix,
      qpp
  ghc-options: -Wall

executable NoCloning
  import: exercises-common
  main-is: NoCloning.hs

executable ExactEvaluation
  import: exercises-common
  main-is: ExactEvaluation.hs

executable QFTSyntax
  import: exercises-common
  main-is: QFTSyntax.hs
  build-depends:
    directory,
    filepath

executable TikZOperators
  import: exercises-common
  main-is: TikZOperators.hs
  build-depends:
    directory,
    filepath


executable ProgramInversion
  import: exercises-common
  main-is: ProgramInversion.hs
  ghc-options:
      -Wno-missing-signatures
      -Wno-name-shadowing
      -Wno-incomplete-uni-patterns

executable YesTeleportation
  import: exercises-common
  build-depends:
    random
  main-is: YesTeleportation.hs

executable TestRepeater
  import: exercises-common
  main-is: TestRepeater.hs
  build-depends:
    random
  ghc-options:
      -Wno-missing-signatures
      -Wno-name-shadowing
      -Wno-incomplete-uni-patterns

-- exercises/TestQFT.hs was removed in 9f022ed; QFT coverage lives in the QFTTest
-- test-suite below.

executable MatrixPreparationTest
  import: exercises-common
  build-depends:
    random,
    vector
  main-is: MatrixPreparationTest.hs
   
executable SVTtest
  import: exercises-common
  build-depends:
    random,
    vector,
    containers,
    poly
  main-is: SVTtest.hs

executable Qubitizationtest
  import: exercises-common
