-- ---------------------------------------------------------------------------
-- Validation suites (tasty).  Run them all with `cabal test all`, or one at a time
-- with `cabal run <name> [-- <tasty options>]`.  See test/README.md.
-- ---------------------------------------------------------------------------

common test-common
  default-language: GHC2021
  hs-source-dirs: test
  build-depends:
      base,
      hmatrix,
      qpp,
      tasty,
      tasty-hunit,
      tasty-quickcheck,
      QuickCheck
  ghc-options: -Wall

test-suite BackendValidation
  import: test-common
  type: exitcode-stdio-1.0
  main-is: BackendValidation.hs
  other-modules: Generators

test-suite MatrixPrepTest
